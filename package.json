{
  "name": "agent-chat",
  "version": "0.1.0",
  "description": "여러 PC 의 AI 에이전트가 WebRTC DataChannel 로 직접 대화하며 공동 테스트를 하는 MCP 서버와 시그널링 서버",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-chat-mcp": "dist/entry/mcp.js",
    "agent-chat-server": "dist/entry/server.js",
    "agent-chat": "dist/entry/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:lambda": "esbuild src/entry/lambda.ts --bundle --platform=node --format=esm --target=node22 --external:@aws-sdk/* --outfile=build/lambda/index.mjs",
    "test": "npm run build && node --test --enable-source-maps \"dist/**/*.test.js\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:wire": "node tests/wire/wire-contract.mjs",
    "test:store": "node deployments/aws/test-store.mjs",
    "test:deploy": "node --test deployments/aws/scripts.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "node-datachannel": "0.33.6",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "3.1105.0",
    "@aws-sdk/client-dynamodb": "3.1105.0",
    "@aws-sdk/lib-dynamodb": "3.1105.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@aws-sdk/util-dynamodb": "3.996.7"
  }
}
